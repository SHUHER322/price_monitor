# Скопируй этот файл в .env и заполни. .env в Git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAH...
# Кто может пользоваться ботом: Telegram ID через запятую (свой ID — у @userinfobot)
ALLOWED_USERS=123456789

# Где хранить базу и служебные файлы (сессию WB, профиль браузера)
DB_PATH=data/monitor.db
DATA_DIR=data

# Как часто проверять цены, в часах (не меньше 1)
CHECK_INTERVAL_HOURS=6
# Уведомлять, если цена упала больше чем на столько процентов
PRICE_DROP_PERCENT=5
# Сколько товаров брать из поисковой выдачи
SEARCH_LIMIT=30
# Сколько отслеживаний можно одному пользователю
MAX_TRACKINGS=20

# Регион доставки WB (от него зависят цены и наличие).
# Свой можно найти в адресах запросов сайта: параметр dest=
WB_DEST=1259570991
# Часовой пояс, в котором показывать время
TIMEZONE=Asia/Tomsk
